# Lokálny vývoj — automatické nastavenie: npm run env:bootstrap
# DB: npm run db:setup (Docker na porte 5433)

# === Povinné ===
DATABASE_URL="postgresql://user:password@localhost:5433/bazos_monitor?schema=public"
CRON_SECRET="change-me-run-npm-run-secrets-generate"

# === Push notifikácie (voliteľné lokálne) ===
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# === AI / Mistral (voliteľné — systém má zabudovaný offline fallback) ===
MISTRAL_API_KEY=""

# === WebMCP / agentic browsing (voliteľné) ===
# npm run webmcp:setup   # registrácia + env + deploy + verify
# npm run webmcp:token -- "TOKEN"
# Lokálne bez tokenu: chrome://flags/#enable-webmcp-testing
NEXT_PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN=""

# === Skripty / CI (nie do Vercel runtime) ===
# PRODUCTION_URL="https://bazos-monitor.vercel.app"
# PLAYWRIGHT_PORT="3099"
# PLAYWRIGHT_BASE_URL="http://localhost:3099"

{
  "name": "bazos-scrapper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/free-port.mjs 3838 && rm -rf .next && node scripts/check-db.mjs --warn",
    "dev": "next dev -p 3838",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -p 3838",
    "lint": "eslint src",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:setup": "docker compose up -d --wait && npm run db:migrate && npm run db:seed",
    "pwa:assets": "node scripts/generate-pwa-assets.mjs",
    "pwa:verify": "node scripts/verify-pwa-checklist.mjs",
    "secrets:generate": "node scripts/generate-deploy-secrets.mjs",
    "env:setup": "node scripts/setup-local-env.mjs",
    "env:bootstrap": "node scripts/env-bootstrap.mjs",
    "vercel:env": "bash scripts/sync-vercel-env.sh",
    "vercel:deploy": "bash scripts/vercel-deploy.sh",
    "webmcp:register": "node --import tsx scripts/set-webmcp-token.mjs --register-only",
    "webmcp:token": "node --import tsx scripts/set-webmcp-token.mjs",
    "webmcp:setup": "node --import tsx scripts/set-webmcp-token.mjs --setup",
    "webmcp:verify": "node --import tsx scripts/verify-webmcp.mjs",
    "pwa:lighthouse": "node scripts/lighthouse-pwa.mjs",
    "agentic:verify": "node scripts/verify-agentic-checklist.mjs",
    "agentic:lighthouse": "node scripts/lighthouse-agentic.mjs",
    "agentic:score": "node scripts/parse-lighthouse-agentic.mjs",
    "test:scripts": "node --import tsx --test scripts/*.test.mjs",
    "test:integration": "node --import tsx scripts/integration-test.mjs",
    "test:integrity": "node --import tsx --test scripts/master-integrity.test.mjs",
    "test": "npm run test:scripts && npm run test:e2e",
    "pwa:dev": "npm run build && npm run start",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@serwist/next": "^9.2.1",
    "@tanstack/query-async-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.16.0",
    "idb-keyval": "^6.2.6",
    "lucide-react": "^0.513.0",
    "next": "^15.3.3",
    "pg": "^8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rss-parser": "^3.13.0",
    "serwist": "^9.2.1",
    "tailwind-merge": "^3.3.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
